# Copy to a private path OUTSIDE this public checkout. Replace every placeholder.
DISCORD_BOT_TOKEN=replace-with-your-bot-token
SZPONT_DISCORD_GUILD_ID=111111111111111111
SZPONT_DISCORD_OWNER_ID=222222222222222222
SZPONT_DISCORD_BOT_ID=333333333333333333
SZPONT_DISCORD_PARENT_CHANNEL_ID=444444444444444444
SZPONT_WORKSPACE=/absolute/private/szpont/workspace
SZPONT_STATE_DIR=/absolute/private/szpont/state
SZPONT_ARTIFACTS_DIR=/absolute/private/szpont/artifacts
CODEX_HOME=/absolute/private/szpont/codex
SZPONT_BROWSER_DIR=/absolute/private/szpont/browser
# Default for NEW conversations. Existing threads keep their recorded runner.
SZPONT_RUNNER=codex
SZPONT_CODEX_BIN=codex
# Experimental Linux host adapters (not supported by the published Docker image).
# See docs/runners.md before opting in. Keep these private paths outside the checkout.
# CLAUDE_CONFIG_DIR=/absolute/private/szpont/claude
# SZPONT_CLAUDE_BIN=claude
# SZPONT_CLAUDE_MODEL=sonnet
# SZPONT_CLAUDE_EFFORT=high
# SZPONT_CLAUDE_MCP_CONFIG=/absolute/private/szpont/claude-mcp.json
# SZPONT_OPENCODE_HOME=/absolute/private/szpont/opencode
# SZPONT_OPENCODE_BIN=opencode
# SZPONT_OPENCODE_MODEL=provider/model
# SZPONT_OPENCODE_CONFIG=/absolute/private/szpont/opencode-provider.json
# Explicit acknowledgement: OpenCode runs with service-account host permissions.
# SZPONT_OPENCODE_HOST_EXECUTION=allow
SZPONT_TASK_TIMEOUT_MS=1200000
