# Copy to a private path OUTSIDE this public checkout. Replace every placeholder.
DISCORD_BOT_TOKEN=replace-with-your-bot-token
PLOMPY_DISCORD_GUILD_ID=111111111111111111
PLOMPY_DISCORD_OWNER_ID=222222222222222222
PLOMPY_DISCORD_BOT_ID=333333333333333333
PLOMPY_DISCORD_PARENT_CHANNEL_ID=444444444444444444
PLOMPY_WORKSPACE=/absolute/private/plompy/workspace
PLOMPY_STATE_DIR=/absolute/private/plompy/state
PLOMPY_ARTIFACTS_DIR=/absolute/private/plompy/artifacts
CODEX_HOME=/absolute/private/plompy/codex
# Optional GitHub integration override. By default, an isolated sibling directory
# of PLOMPY_STATE_DIR is used; your personal gh login is never imported.
# GH_CONFIG_DIR=/absolute/private/plompy/github
PLOMPY_BROWSER_DIR=/absolute/private/plompy/browser
# Default for NEW conversations. Existing threads keep their recorded runner.
PLOMPY_RUNNER=codex
PLOMPY_CODEX_BIN=codex
# Experimental Linux host adapters (not supported by the published Docker image).
# See docs/runners.md before opting in. Keep these private paths outside the checkout.
# CLAUDE_CONFIG_DIR=/absolute/private/plompy/claude
# PLOMPY_CLAUDE_BIN=claude
# PLOMPY_CLAUDE_MODEL=sonnet
# PLOMPY_CLAUDE_EFFORT=high
# Optional override; integrations CLI otherwise uses CLAUDE_CONFIG_DIR/plompy-mcp.json.
# PLOMPY_CLAUDE_MCP_CONFIG=/absolute/private/plompy/claude-mcp.json
# PLOMPY_OPENCODE_HOME=/absolute/private/plompy/opencode
# PLOMPY_OPENCODE_BIN=opencode
# PLOMPY_OPENCODE_MODEL=provider/model
# Optional override; integrations CLI otherwise uses PLOMPY_OPENCODE_HOME/plompy-mcp.json.
# PLOMPY_OPENCODE_CONFIG=/absolute/private/plompy/opencode-provider.json
# Explicit acknowledgement: OpenCode runs with service-account host permissions.
# PLOMPY_OPENCODE_HOST_EXECUTION=allow
PLOMPY_TASK_TIMEOUT_MS=1200000
