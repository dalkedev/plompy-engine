{
  "name": "plompy-engine",
  "version": "0.12.0",
  "private": true,
  "description": "A self-hosted personal agent with Discord conversations and Git-backed memory",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "build": "npm --prefix apps/discord-agent run build",
    "test": "npm --prefix apps/discord-agent test && node --test scripts/*.test.mjs",
    "doctor": "node scripts/doctor.mjs",
    "setup": "node scripts/setup.mjs",
    "acceptance": "node scripts/acceptance.mjs",
    "integrations": "node scripts/integrations.mjs",
    "init:workspace": "node scripts/init-workspace.mjs",
    "state:snapshot": "node scripts/state-snapshot.mjs",
    "demo": "node --disable-warning=ExperimentalWarning scripts/demo.mjs"
  },
  "license": "MIT"
}
